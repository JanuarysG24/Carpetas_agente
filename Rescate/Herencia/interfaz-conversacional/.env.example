# Copia este archivo como  .env  (sin el .example) y pon tu clave real.
# El archivo .env NO se sube al repositorio: la rúbrica del reto exige que no
# haya credenciales en el repo público.
#
# Tu clave gratuita se saca en https://console.groq.com/  -> API Keys

GROQ_API_KEY=pega_aqui_tu_clave

# Opcional: cambiar el puerto si el 8787 está ocupado.
# PUERTO=8787
